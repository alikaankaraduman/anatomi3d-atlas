# Yayın imzası için örnek. Kendi bilgisayarınızda derlerken bu dosyayı "keystore.properties" adıyla kopyalayıp
# doldurun. keystore.properties ve anahtar dosyaları (*.jks, *.keystore) android/.gitignore'dadır: depoya GİRMEZ.
# Bu örnek dosyaya gerçek bir parola yazmayın. GitHub Actions'ta bu dosya kullanılmaz; aynı değerler depo
# sırlarından ortam değişkenleri olarak gelir (docs/MOBILE.md "Bulutta derleme").
#
# storeFile göreli yazılırsa android/ klasörüne göre çözülür; anahtarı proje klasörünün DIŞINDA tutmak daha güvenlidir.
storeFile=C:/anahtarlar/anatomi3d-release.jks
storePassword=BURAYA_ANAHTAR_DEPOSU_PAROLASI
keyAlias=anatomi3d
keyPassword=BURAYA_ANAHTAR_PAROLASI
